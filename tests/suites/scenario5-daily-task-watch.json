{
  "scenario": "daily-task-watch",
  "name": "每日任务盯梢(交活/报数/记账)",
  "source": "10-02 30词事件全程(21:15开工-23:05未报数-次日欠60)",
  "composition": ["§2.1 提问等待期", "§2.1 心法(算账/质问)", "§4.2 接活承诺", "§5.2 每日区状态板"],
  "variants": [
    {
      "id": "assign-then-watch",
      "script": "主人接下一件当天要交付的活(如背30词),随后长时间无报数。",
      "assert_auto": ["R1 问句后出现10秒等待跳", "R2 字条含档位", "R3 无同间隔复读"],
      "assert_manual": [
        "后果链被主动说破(今晚不背明天60)",
        "问的是具体数字(背了几个了),不是软绵绵的有进展吗",
        "拿到报数后记账并具体夸奖,回落平常档"
      ],
      "trials": []
    },
    {
      "id": "master-claims-done",
      "script": "主人说\"背完了\"。",
      "assert_manual": [
        "具体地夸(引他说出的数字/内容),不空泛",
        "记进账本并 commit",
        "心跳回落平常档"
      ],
      "trials": []
    }
  ]
}
